% Draw rock markers
%% ================================================================

function drawRockMarkers(ax,map)

[height,width] = size(map);

%% Sample obstacle cells

for y = 2:height-1

    for x = 2:width-1

        if map(y,x) == 1

            %% Only draw selected cells
            if mod(x+y,7) == 0

                plot(ax, ...
                    x, ...
                    y, ...
                    '.', ...
                    'MarkerSize',5);

            end

        end

    end

end

